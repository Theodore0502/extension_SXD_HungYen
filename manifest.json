{
  "manifest_version": 3,
  "name": "Vinasynet - Tự Động Rà Soát & Xóa Hồ Sơ Trùng Lặp",
  "version": "1.1.36",
  "description": "Tiện ích kiểm tra nhanh, kiểm tra hàng loạt và tự động xóa trùng hồ sơ lưu trữ Vinasynet theo quy trình 7 bước (Hỗ trợ Microsoft Edge Sidebar & Tự lưu dữ liệu).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://ktdl.soxaydung.hungyen.gov.vn/*",
    "http://ktdl.soxaydung.hungyen.gov.vn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://ktdl.soxaydung.hungyen.gov.vn/*",
        "http://ktdl.soxaydung.hungyen.gov.vn/*"
      ],
      "js": ["scripts/inject-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ktdl.soxaydung.hungyen.gov.vn/*",
        "http://ktdl.soxaydung.hungyen.gov.vn/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["process_checklist_seed.json"],
      "matches": ["*://ktdl.soxaydung.hungyen.gov.vn/*", "http://ktdl.soxaydung.hungyen.gov.vn/*"]
    }
  ]
}
